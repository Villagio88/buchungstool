# Vorlage für die Konfiguration. Kopieren nach buchung.env und ausfüllen.
# buchung.env enthält Kalenderlinks und ein Mailpasswort: nie einchecken.
# Nach Änderungen genügt ein Neustart: docker compose up -d

# --- Allgemein ---
# Name im Seitentitel, in den Einladungen und als Unterschrift der Mails
INHABER_NAME=Alex Muster
# Öffentliche Adresse der Seite, für die Absage-Links in den Mails (Pflicht)
SEITEN_URL=https://termin.example.com
# Zieladresse für Bereiche ohne eigene BEREICH_<NAME>_MAIL
# INHABER_MAIL=alex@example.com
# Optional, sonst «Termin mit <INHABER_NAME> buchen»
# SEITEN_TITEL=Termin buchen
# Zeitzone für Bürozeiten und die Anzeige. Die Einladungen selbst stehen in UTC
# und stimmen in jeder Zone.
TZ=Europe/Zurich

# --- Kalender für die Verfügbarkeit (nur lesend, beliebig viele) ---
# Jeder Kalender, der sich als ICS-Link (iCal-Abo) freigeben lässt.
# Belegt ist, was in irgendeinem dieser Kalender steht.
KALENDER=arbeit,privat

# Microsoft 365 / Outlook: Einstellungen > Kalender > Freigegebene Kalender >
# Kalender veröffentlichen > Berechtigung «Kann anzeigen, wann ich beschäftigt
# bin» > ICS-Link. In manchen Organisationen sperrt die IT das Veröffentlichen.
KALENDER_ARBEIT_URL=https://outlook.office365.com/owa/calendar/.../calendar.ics
# Mindestabstand in Minuten zu Terminen aus diesem Kalender
KALENDER_ARBEIT_PUFFER=15

# Proton Calendar: Einstellungen > Kalender > Teilen > Link erstellen
# «Limited view» (nur belegt) genügt und ist vorzuziehen. Proton aktualisiert
# den Link mit Verzögerung, laut Proton bis zu acht Stunden.
KALENDER_PRIVAT_URL=https://calendar.proton.me/api/calendar/v1/url/.../calendar.ics?CacheKey=...&PassphraseKey=...
KALENDER_PRIVAT_PUFFER=30

# Optional je Kalender: Einträge länger als N Stunden ignorieren (0 = aus)
# KALENDER_PRIVAT_MAX_STUNDEN=0
# Standardabstand für Kalender ohne eigenen Wert
PUFFER_STANDARD=15
# Titel, die nie blockieren (Teiltreffer, Komma getrennt)
KALENDER_IGNORIEREN=Ferien,Stand-up
# Ganztägige Einträge blockieren den Tag (Standard 1)
# GANZTAGS_BLOCKIERT=1

# --- Bereiche: wofür gebucht werden kann ---
# Jeder Bereich hat eine eigene Zieladresse. Die Einladung geht dorthin und
# landet so im passenden Kalender. Der Schlüssel ist zugleich der kurze Pfad
# (/beratung, /privat): nur Kleinbuchstaben, Ziffern und Bindestrich. Bereiche
# ohne gültige Zieladresse werden nicht angeboten.
BEREICHE=beratung,privat
# Ohne ?fuer= oder kurzen Pfad sichtbar (Standard: alle)
BEREICHE_OEFFENTLICH=beratung

BEREICH_BERATUNG_NAME=Beratung
BEREICH_BERATUNG_MAIL=alex@firma.example
BEREICH_BERATUNG_HINWEIS=Projekte, Workshops und Zusammenarbeit
BEREICH_BERATUNG_AKZENT=#0f766e
# Logo als Datei in public/marke/
# BEREICH_BERATUNG_LOGO=/marke/firma.png
# BEREICH_BERATUNG_LOGO_ALT=Firma AG
# Bevorzugte Zeiten, nur Empfehlung: mo,di-vormittag,mi-nachmittag
BEREICH_BERATUNG_WUNSCHZEITEN=di,do-vormittag
# 0 = alle freien Zeiten gleichwertig, ohne Empfehlungen
# BEREICH_BERATUNG_EMPFEHLUNGEN=1
# Weitere Pfade für denselben Bereich, etwa /erstgespraech
# BEREICH_BERATUNG_ALIAS=erstgespraech
# Eigene Schrift: Datei in public/marke/ und ihr Name
# BEREICH_BERATUNG_SCHRIFTDATEI=/marke/schrift.woff2
# BEREICH_BERATUNG_SCHRIFT=Montserrat
# Hinweis über den weiteren, nicht empfohlenen Zeiten
# BEREICH_BERATUNG_HINWEIS_WEITERE=Diese Zeiten gehen auch, sind aber weniger günstig.

BEREICH_PRIVAT_NAME=Privat
BEREICH_PRIVAT_MAIL=alex@privat.example
BEREICH_PRIVAT_HINWEIS=Alles Persönliche

# --- Mailversand (SMTP) ---
# Port 465 = TLS, 587 = STARTTLS. Gmail: smtp.gmail.com, Port 465, App-Passwort.
# Datenschutz: Steht der Mailanbieter in einem anderen Staat, gehört dieser
# Staat in die Datenschutzerklärung (DATENSCHUTZ_MAILDIENST, etwa
# «Gmail, Google Ireland Limited, Irland»). Für das Schweizer revDSG ist auch
# die EU Ausland.
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_USER=termine@example.com
MAIL_PASS=

# --- Zeiten und Regeln ---
ARBEITSTAGE=1,2,3,4,5
VON_UHR=08:00
BIS_UHR=17:00
# Randzeiten, nur über ?anfrage=1 buchbar und in der Mail markiert
ANFRAGE_VON_UHR=07:00
ANFRAGE_BIS_UHR=20:00
START_RASTER_MINUTEN=15
DAUER_MIN_MINUTEN=15
DAUER_MAX_MINUTEN=240
DAUER_SCHRITT_MINUTEN=1
DAUER_STANDARD_MINUTEN=60
VORLAUF_STUNDEN=12
HEUTE_BUCHBAR=0
VORAUS_TAGE=120
PUFFER_EIGENE=15
MAX_PRO_MAIL_TAG=3
MAX_PRO_IP_TAG=5

# --- Datensparsamkeit ---
# IP-Adressen (nur für die Missbrauchsgrenze) nach so vielen Tagen entfernen
LOESCHEN_IP_NACH_TAGEN=7
# Name, Mail, Anliegen und Ort so viele Tage nach dem Termin entfernen
LOESCHEN_PERSONENDATEN_NACH_TAGEN=90
# Speicherort der Datenbank (im Docker-Abbild vorgegeben: /data/buchung.db)
# DATENBANK_PFAD=./data/buchung.db

# Ferien nur als Markierung, gesperrt wird nichts: von:bis:Name, Komma getrennt
# FERIEN=2026-12-21:2027-01-03:Weihnachtsferien
# Nur in diesen Bereichen anzeigen (Standard: alle)
# FERIEN_BEREICHE=beratung

# Text rechts in der Fusszeile (Standard: «Buchungstool, Open Source»)
# FUSSZEILE=

# --- Impressum und Datenschutz ---
IMPRESSUM_NAME=
IMPRESSUM_ADRESSE=Strasse 1\n1234 Ort\nLand
IMPRESSUM_MAIL=
IMPRESSUM_TELEFON=
DATENSCHUTZ_MAILDIENST=
DATENSCHUTZ_SERVERORT=
