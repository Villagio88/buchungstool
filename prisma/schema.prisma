generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Eine gebuchte Zeit.
model Buchung {
  id       String   @id @default(cuid())
  start    DateTime
  ende     DateTime
  /// Die vom Gast gewählte Dauer in Minuten.
  minuten  Int
  /// Schlüssel des Bereichs (BEREICHE). Bestimmt, an welche Adresse die Einladung ging.
  bereich  String
  name     String
  email    String
  anliegen String?
  /// Wo der Termin stattfindet. Optional in der Datenbank, damit das Feld ohne
  /// Datenverlust nachgerüstet werden konnte; im Formular ist es Pflicht.
  ort      String?
  /// Nur zur Missbrauchsabwehr, nicht für Auswertungen.
  ip       String?
  erstellt DateTime @default(now())
  /// Geheimnis im Absage-Link. Wer es hat, darf diesen Termin absagen.
  /// Optional, damit das Feld ohne Datenverlust nachgerüstet werden konnte:
  /// Ältere Buchungen ohne Token sind nur von Hand absagbar.
  token     String?  @unique
  /// Eigenes Geheimnis für den Absage-Link in der Mail an den Inhaber. Getrennt
  /// vom Gast-Token, damit klar ist, wer abgesagt hat.
  tokenInhaber String? @unique
  /// Gesetzt, wenn der Termin abgesagt wurde. Die Zeile bleibt als Verlauf stehen,
  /// nur die Belegungseinheiten verschwinden und geben den Slot wieder frei.
  storniert DateTime?
  /// Wer abgesagt hat: gast oder inhaber.
  storniertVon String?

  einheiten Belegung[]

  @@index([start])
  @@index([email, erstellt])
  @@index([ip, erstellt])
}

/// Jede angefangene Fünf-Minuten-Einheit einer Buchung.
///
/// Das ist die eigentliche Sperre gegen Überschneidungen. Seit die Dauer frei
/// wählbar ist, reicht ein eindeutiger Index auf dem Startzeitpunkt nicht mehr:
/// 10:00 bis 11:00 und 10:30 bis 11:30 haben verschiedene Starts, kollidieren
/// aber trotzdem. Weil `einheit` der Primärschlüssel ist, lässt die Datenbank
/// zwei sich überlappende Buchungen gar nicht erst zu, auch nicht bei zwei
/// gleichzeitigen Anfragen.
model Belegung {
  einheit   DateTime @id
  buchungId String
  buchung   Buchung  @relation(fields: [buchungId], references: [id], onDelete: Cascade)

  @@index([buchungId])
}
